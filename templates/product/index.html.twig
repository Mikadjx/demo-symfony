{% extends 'base.html.twig' %}

{% block title %}Catalogue — La Petite Maison de l'Épouvante{% endblock %}

{% block stylesheets %}
<style>
  .catalogue-header {
    padding: 2.5rem 2rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .catalogue-header h1 {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .catalogue-header p {
    font-style: italic;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ── Filtres ─────────────────────────────────────── */
  .filters {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  .filter-label {
    font-family: 'Cinzel Decorative', serif;
    font-size: 0.6rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 0.4rem;
  }
  .filter-btn {
    font-size: 0.8rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    cursor: pointer;
  }
  .filter-btn:hover,
  .filter-btn.active {
    border-color: var(--crimson);
    color: var(--crimson);
  }
  .filter-separator {
    width: 1px;
    height: 18px;
    background: var(--border);
    margin: 0 0.4rem;
  }

  /* ── Grille produits ─────────────────────────────── */
  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 2rem;
  }
  .product-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.4rem;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .product-card:hover {
    transform: translateY(-4px);
    border-color: var(--blood);
    box-shadow: 0 8px 24px rgba(139,0,0,0.12);
  }
  .product-category {
    font-family: 'Cinzel Decorative', serif;
    font-size: 0.58rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--crimson);
    margin-bottom: 0.5rem;
  }
  .product-name {
    font-family: 'Cinzel Decorative', serif;
    font-size: 0.9rem;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .product-desc {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 0.9rem;
  }
  .product-price {
    font-family: 'Cinzel Decorative', serif;
    font-size: 1.05rem;
    color: var(--crimson);
  }
  .stock-ok   { color: #4caf50; font-size: 0.8rem; }
  .stock-low  { color: #ff9800; font-size: 0.8rem; }
  .stock-empty { color: #f44336; font-size: 0.8rem; }

  /* ── Recommandations ─────────────────────────────── */
  .recommendations {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }
  .recommendations h2 {
    font-family: 'Cinzel Decorative', serif;
    font-size: 1rem;
    color: var(--crimson);
    letter-spacing: 2px;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .reco-grid {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .reco-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1rem 1.2rem;
    min-width: 180px;
    transition: border-color 0.2s;
  }
  .reco-card:hover { border-color: var(--blood); }
  .reco-name {
    font-family: 'Cinzel Decorative', serif;
    font-size: 0.8rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }
  .reco-price { font-size: 0.85rem; color: var(--crimson); }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
{% endblock %}

{% block body %}

<div class="catalogue-header">
  <h1>Catalogue</h1>
  <p>{{ products|length }} produit{% if products|length > 1 %}s{% endif %} disponible{% if products|length > 1 %}s{% endif %}</p>
</div>

{# ── Filtres catégorie + tri ────────────────────────── #}
<div class="filters">
  <span class="filter-label">Catégorie</span>

  <a href="{{ path('app_product_index', activeSort ? {sort: activeSort} : {}) }}"
     class="filter-btn {% if not activeCategory %}active{% endif %}">
    Tous
  </a>

  {% for cat in ['figurines', 'blu-ray', 'fanzine', 'jeux'] %}
    <a href="{{ path('app_product_index', {category: cat}|merge(activeSort ? {sort: activeSort} : {})) }}"
       class="filter-btn {% if activeCategory == cat %}active{% endif %}">
      {{ cat|capitalize }}
    </a>
  {% endfor %}

  <div class="filter-separator"></div>
  <span class="filter-label">Tri</span>

  <a href="{{ path('app_product_index', activeCategory ? {category: activeCategory} : {}) }}"
     class="filter-btn {% if not activeSort %}active{% endif %}">
    Par défaut
  </a>
  <a href="{{ path('app_product_index', {sort: 'price_asc'}|merge(activeCategory ? {category: activeCategory} : {})) }}"
     class="filter-btn {% if activeSort == 'price_asc' %}active{% endif %}">
    Prix croissant
  </a>
</div>

{# ── Grille produits ────────────────────────────────── #}
{% if products is empty %}
  <div class="empty-state">
    Aucun produit disponible dans cette catégorie.
  </div>
{% else %}
  <div class="catalogue-grid">
    {% for product in products %}
    <div class="product-card">
      <div class="product-category">{{ product.category }}</div>
      <div class="product-name">{{ product.name }}</div>
      {% if product.description %}
        <p class="product-desc">{{ product.description }}</p>
      {% endif %}
      <div class="product-footer">
        <span class="product-price">{{ product.price }} €</span>
        <span class="{{ product.stock > 10 ? 'stock-ok' : (product.stock > 0 ? 'stock-low' : 'stock-empty') }}">
          {% if product.stock > 10 %}
            En stock
          {% elseif product.stock > 0 %}
            Plus que {{ product.stock }}
          {% else %}
            Rupture
          {% endif %}
        </span>
      </div>
    </div>
    {% endfor %}
  </div>
{% endif %}

{# ── Recommandations (US-02) ────────────────────────── #}
{% if recommended is not empty %}
<div class="recommendations">
  <h2>Vous aimerez aussi</h2>
  <div class="reco-grid">
    {% for item in recommended %}
    <div class="reco-card">
      <div class="reco-name">{{ item.name }}</div>
      <div class="reco-price">{{ item.price }} €</div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% endblock %}
